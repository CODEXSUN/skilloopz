model Concept {
  id          String   @id @default(uuid())
  title       String
  description String?
  difficulty  Int      @default(1)
  domain      String   @default("coding")
  icon        String?
  color       String?  @default("#3b82f6")
  worldId     String?  @map("world_id")
  islandId    String?  @map("island_id")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  world         Island?               @relation(fields: [islandId], references: [id])
  prerequisites ConceptPrerequisite[] @relation("ConceptPrerequisite")
  dependents    ConceptPrerequisite[] @relation("ConceptDependent")

  @@index([domain])
  @@index([worldId])
  @@index([islandId])
  @@map("concepts")
}

model ConceptPrerequisite {
  id              String @id @default(uuid())
  conceptId       String @map("concept_id")
  prerequisiteId  String @map("prerequisite_id")

  concept      Concept @relation("ConceptPrerequisite", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite Concept @relation("ConceptDependent", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([conceptId, prerequisiteId])
  @@index([conceptId])
  @@index([prerequisiteId])
  @@map("concept_prerequisites")
}

